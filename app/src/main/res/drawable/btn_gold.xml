<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4DFFB35C" />
            <stroke android:width="1.5dp" android:color="@color/amber_hi" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <stroke android:width="1dp" android:color="#223D4652" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#33FFC86B" android:endColor="#14F2B35C" android:angle="270" />
            <stroke android:width="1dp" android:color="#99F2B35C" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
