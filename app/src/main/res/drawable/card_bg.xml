<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#33F2B35C" android:endColor="#121F1A14" android:angle="270" />
            <stroke android:width="1.5dp" android:color="@color/amber" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1dp" android:color="#66F2B35C" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#E6151A20" android:endColor="#E60C0F13" android:angle="270" />
            <stroke android:width="1dp" android:color="#3D2C3540" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
