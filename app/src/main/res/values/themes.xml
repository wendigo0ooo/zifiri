<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zifiri" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="colorPrimary">@color/amber</item>
        <item name="colorPrimaryVariant">@color/amber_dim</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/teal</item>
        <item name="colorOnSecondary">@color/bg</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Zifiri.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/panel_bg</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="colorPrimary">@color/amber</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Zifiri.Title" parent="">
        <item name="android:textColor">@color/amber_hi</item>
        <item name="android:textSize">44sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">3</item>
        <item name="android:shadowRadius">12</item>
    </style>

    <style name="Zifiri.Subtitle" parent="">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.24</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Zifiri.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/btn_gold</item>
        <item name="android:textColor">@color/amber_hi</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">#44FFD08A</item>
    </style>

    <style name="Zifiri.Button.Ghost" parent="Zifiri.Button">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Zifiri.Card" parent="">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">14dp</item>
    </style>
</resources>
